#!/usr/bin/env sh
# Gradle wrapper launcher. scripts/prepare_android.py restores the official
# wrapper JAR from Flutter when it is unavailable in an offline source archive.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
    echo 'Gradle wrapper JAR missing. Run python3 scripts/prepare_android.py from the project root with Flutter installed.' >&2
    exit 1
fi
if [ -n "${JAVA_HOME:-}" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi
# JVM options use Gradle's conventional space-separated shell option handling.
# shellcheck disable=SC2086
exec "$JAVACMD" ${JAVA_OPTS:-} ${GRADLE_OPTS:-} -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
